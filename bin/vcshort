#!/usr/bin/env bash
# vcshort 启动器 — 使用系统 Python（用户需自行安装 Python 3.10+）
# 兼容 macOS/Linux 与 Windows Git Bash
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$DIR")"

export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

# 查找系统 Python
PY=""
for cmd in python3 python python3.12 python3.11 python3.10; do
  if command -v "$cmd" >/dev/null 2>&1; then
    PY="$(command -v "$cmd")"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "错误：未找到系统 Python。请安装 Python 3.10+（https://www.python.org/downloads/）"
  echo "安装后请运行：pip install -r \"$ROOT/requirements.txt\""
  exit 1
fi

exec "$PY" "$ROOT/src/vcshort/__main__.py" "$@"
